# Self-hosted LiveKit server.
# LIVEKIT_URL is the signalling WebSocket URL. Browsers require wss:// (TLS) in
# production; ws://localhost is fine for local development only.
LIVEKIT_URL=wss://livekit.example.com

# From the `keys:` block of your livekit.yaml. Never expose the secret to the client.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
